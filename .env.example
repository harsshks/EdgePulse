# .env.example
# Copy this file to .env and adjust values for your environment.
# .env is gitignored and should never be committed.
# All values shown here are safe defaults for local development.

# --- MQTT Broker ---
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC=telemetry/vehicle

# --- Storage ---
DATABASE_PATH=edgepulse.db
LOG_FILE=logs/telemetry.jsonl

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000

# --- Logging ---
# Valid levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- Phase 2: Feature Engineering ---
FEATURE_WINDOW_SIZE=60
FEATURE_MIN_SAMPLES=3
BASELINE_MIN_SAMPLES=30
TEMP_WARNING_THRESHOLD=100.0
SCORE_WARNING_THRESHOLD=2.0
SCORE_SEVERE_THRESHOLD=3.5
